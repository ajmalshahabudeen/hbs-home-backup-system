APP_PORT=38480
APP_URL=http://127.0.0.1:38480
HEALTH_URL=http://127.0.0.1:38480/api/health

POSTGRES_USER=hbs
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hbs_backup
POSTGRES_PORT=5432

BETTER_AUTH_SECRET=generate-a-long-random-string-here-32+
BETTER_AUTH_URL=http://localhost:38480
NEXT_PUBLIC_APP_URL=http://localhost:38480

# Windows examples: F:/  |  F:\HBS-Backups  |  D:/Backups
# Linux examples:   /mnt/data  |  /var/hbs-storage
# Hard drive / folder for backup files (bind-mounted into Docker as /data/storage)
# USE FORWARD SLASHES. Do NOT set bare "G:\" — Docker errors with "too many colons".
# Windows:  G:/HBS-Backups    F:/Backups
# Linux:    /mnt/data/hbs
# Dev:      ./data/storage
HOST_STORAGE_PATH=./data/storage

REDIS_URL=redis://localhost:6380/0
QUEUE_BACKEND=celery
WORKER_CONCURRENCY=3

# Optional Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Better Auth multi-client LAN (see packages/auth/auth.ts)
BETTER_AUTH_STRICT_ORIGINS=false
# BETTER_AUTH_PUBLIC_HOSTS=
# BETTER_AUTH_TRUSTED_ORIGINS=
