{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@workspace/auth": ["../../packages/auth/index.ts"],
      "@workspace/auth/*": ["../../packages/auth/*"],
      "@workspace/db": ["../../packages/db/index.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
